# Arc testnet RPC (with embedded server token). Get this from:
#   arc-canteen rpc-url
# If you ran `arc-canteen shell-init` you can also leave RPC_URL blank and
# rely on $RPC being loaded from ~/.arc-canteen/env.
RPC_URL=

# Deployer / agent wallet — must hold testnet USDC to deploy and create markets.
# Generate locally; never commit.
PRIVATE_KEY=

# Anthropic API key for the agent's probability estimator.
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=

# NewsAPI key for the event scanner. Free tier is fine for dev.
# Get from https://newsapi.org
NEWSAPI_KEY=
